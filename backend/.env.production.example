# -----------------------------------------------------------------------------
# Production environment template
# -----------------------------------------------------------------------------
# Copy to backend/.env on the server, fill every secret, then run:
#   php artisan key:generate --force
#   php artisan migrate --force
#   php artisan config:cache
#   php artisan route:cache
#   php artisan view:cache
#
# Never commit the real .env. Keep it readable only by the deploy user.
# -----------------------------------------------------------------------------

APP_NAME="HB Tronics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://app.example.com
# Comma-separated IPs/CIDRs of your load balancer or reverse proxy.
TRUSTED_PROXIES=
# Comma-separated host patterns, e.g. app.example.com,www.app.example.com
TRUSTED_HOSTS=app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# Keep application logs on a rotating disk and ship them to your aggregator.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Optional critical-alert webhook.
LOG_SLACK_WEBHOOK_URL=

# Database: use MySQL or PostgreSQL, never SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hbt_learning
DB_USERNAME=hbt_learning
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Shared cache, sessions, and queues. Redis is required for multi-instance
# deployments; database cache/queue also works for a single node.
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Sanctum token lifetime and prefix.
SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=hbt_

# Transactional email: use a real SMTP provider in production.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_TO=support@example.com

# Media storage. Prefer S3-compatible object storage in production.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# Internal amounts are major units. Stripe receives minor units at the
# gateway boundary. Stripe does not support DZD; DZD checkouts fall back to
# manual settlement (bank transfer/cash) unless another local gateway is added.
APP_CURRENCY=DZD

STRIPE_ENABLED=true
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal has no production integration yet. Leave disabled until implemented.
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=live

# Bot protection for public auth/contact forms. The honeypot is always on;
# Turnstile activates only when BOTH keys are set. Create a widget at
# https://dash.cloudflare.com/ and keep TURNSTILE_ENABLED=true in production.
BOT_HONEYPOT_FIELD=website
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MANUAL_PAYMENTS_ENABLED=true

# A crashed webhook worker's claim expires after this many seconds.
PAYMENT_WEBHOOK_CLAIM_TTL=300

# SMS two-factor authentication (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
# Used by scripts/backup-database.sh. Store backups off the application host.
BACKUP_DIR=/var/backups/hbt
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=hbt/database
