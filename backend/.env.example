APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Comma-separated browser origins allowed to call the API with credentials
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Sanctum personal access token lifetime in minutes (default 24h)
SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=hbt_
# Force secure cookies in production (defaults to true when APP_ENV=production)
SESSION_SECURE_COOKIE=

# SMS two-factor authentication (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Inbox for public contact-form submissions (support mailbox).
MAIL_CONTACT_TO=support@hbtronics.dz

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=true

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYPAL_ENABLED=false

# Bot protection for public auth/contact forms. The honeypot needs no
# provider. Turnstile stays off until both keys are configured.
BOT_HONEYPOT_FIELD=website
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MANUAL_PAYMENTS_ENABLED=true
APP_CURRENCY=DZD
PAYMENT_WEBHOOK_CLAIM_TTL=300

# Comma-separated reverse proxies you control (empty = trust none).
TRUSTED_PROXIES=
# Comma-separated allowed host patterns (empty = enforce APP_URL host).
TRUSTED_HOSTS=

VITE_APP_NAME="${APP_NAME}"
